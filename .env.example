# -----------------------------------------------------------------------------
# DOCKER & ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Local: mongodb://localhost:27017/schooltrack
# Docker: mongodb://admin:secure_password_here@mongodb:27017/schooltrack?authSource=admin
MONGODB_URI=mongodb://localhost:27017/schooltrack

# MongoDB Init (Only used by Docker initialization)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secure_password_here
MONGO_INITDB_DATABASE=schooltrack

# -----------------------------------------------------------------------------
# REDIS (Optional caching layer)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Docker: redis://redis:6379

# -----------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# -----------------------------------------------------------------------------
# Generate a secure 64-character hex string for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_key_change_me_in_production
JWT_EXPIRE=7d

# Session secret (Fallback to JWT_SECRET if not set)
SECRET_SESSION=your_super_secure_session_secret_key

# -----------------------------------------------------------------------------
# CORS & FRONTEND
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# EXTERNAL APIs
# -----------------------------------------------------------------------------
# Geocoding & Maps
MAPTILER_API_KEY=your_maptiler_api_key_here
GRAPHHOPPER_API_KEY=your_graphhopper_api_key_here
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
# Optional LocationIQ key for better geocoding accuracy
LOCATIONIQ_API_KEY=

# -----------------------------------------------------------------------------
# VUE FRONTEND (These must start with VUE_APP_)
# -----------------------------------------------------------------------------
VUE_APP_API_URL=http://localhost:3000/api
VUE_APP_SOCKET_URL=http://localhost:3000
VUE_APP_MAPTILER_KEY=your_maptiler_api_key_here
VUE_APP_ENVIRONMENT=development
VUE_APP_VERSION=1.0.0
VUE_APP_NAME=SchoolTrack