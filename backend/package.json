{
    "name": "schooltrack-backend",
    "version": "1.0.0",
    "description": "Backend API para SchoolTrack - Sistema de seguimiento de transporte escolar",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --verbose",
        "test:auth": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/auth.test.js --verbose",
        "test:vehicles": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/vehicles.test.js --verbose",
        "test:students": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/students.test.js --verbose",
        "test:routes": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/routes.test.js --verbose",
        "test:websockets": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/websockets.test.js --verbose",
        "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "lint": "eslint src/",
        "create-indexes": "node src/scripts/createIndexes.js",
        "seed": "node src/seeds/seedData.js",
        "seed:admin": "node src/scripts/seedAdmin.js"
    },
    "dependencies": {
        "axios": "^1.5.0",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.18.2",
        "express-mongo-sanitize": "^2.2.0",
        "express-rate-limit": "^6.10.0",
        "express-session": "^1.18.2",
        "helmet": "^7.0.0",
        "hpp": "^0.2.3",
        "joi": "^18.2.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^7.5.0",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-schedule": "^2.1.0",
        "qrcode": "^1.5.3",
        "redis": "^4.6.7",
        "socket.io": "^4.7.2",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@jest/globals": "^30.4.1",
        "cross-env": "^10.1.0",
        "eslint": "^8.47.0",
        "jest": "^29.6.4",
        "mongodb-memory-server": "^11.1.0",
        "nodemon": "^3.0.1",
        "socket.io-client": "^4.8.3",
        "supertest": "^7.2.2"
    },
    "author": "SchoolTrack Team",
    "license": "MIT"
}
